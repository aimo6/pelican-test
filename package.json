{
  "name": "pelican-test",
  "version": "1.0.0",
  "private": true,
  "description": "鹈鹕测试 —— 用于测试大语言模型生成 SVG 图形能力的工具，支持网页版与桌面版",
  "author": "aimo6",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "electron .",
    "build:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.pelican.svgtest",
    "productName": "PelicanTest",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "js/**/*",
      "styles/**/*",
      "desktop/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "electron-winstaller@5.4.0": true
  }
}
